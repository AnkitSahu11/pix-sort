# PixSort Server Environment Configuration

# Server & Client
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# MongoDB Connection
MONGO_URI=mongodb://127.0.0.1:27017/pixsort

# JWT Secrets & Expiration
JWT_SECRET=replace_with_a_long_random_jwt_secret_key
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=replace_with_a_long_random_refresh_secret_key
JWT_REFRESH_EXPIRES_IN=7d

# SMTP Email Configuration (Nodemailer)
# For Gmail: Use a 16-character Google App Password (not standard account password)
EMAIL_SERVICE=gmail
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=PixSort <no-reply@pixsort.local>

# Token Expiration Settings
VERIFICATION_EXPIRES_MINUTES=30
RESET_EXPIRES_MINUTES=30

# File Upload Limits
MAX_UPLOAD_FILES=500
MAX_FILE_SIZE_MB=50
